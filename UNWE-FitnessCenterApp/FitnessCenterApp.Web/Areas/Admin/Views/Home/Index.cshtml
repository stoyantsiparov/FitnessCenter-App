@{
    ViewData["Title"] = "Административно табло";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 bg-white p-4 shadow-sm header-border-unwe">
        <div class="text-center text-md-start mb-3 mb-md-0">
            <h2 class="fw-bold text-unwe">Административно табло</h2>
            <p class="text-muted mb-0">Оперативно управление на платформата</p>
        </div>
        <div style="width: 250px;">
            <a asp-area="Admin" asp-controller="Reports" asp-action="Index"
               class="btn btn-primary w-100 py-2 fw-bold">
                <i class="fas fa-chart-line me-2"></i> Бизнес справки и Анализи
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card shadow h-100 border-0">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <i class="fas fa-users fa-3x text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Управление на потребители</h5>
                    <p class="card-text text-muted">Добавяйте, редактирайте или изтривайте потребители и техните роли.</p>
                    <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="btn btn-primary mt-auto w-100">
                        Към Потребители
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100 border-0">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <i class="fas fa-id-card fa-3x text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Абонаментни планове</h5>
                    <p class="card-text text-muted">Добавяйте, редактирайте или изтривайте типове абонаменти.</p>
                    <a asp-area="Admin" asp-controller="MembershipTypesManagement" asp-action="Index" class="btn btn-primary mt-auto w-100">
                        Към Абонаментни планове
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100 border-0">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <i class="fas fa-user-tie fa-3x text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Управление на инструктори</h5>
                    <p class="card-text text-muted">Управлявайте екипа от треньори и инструктори.</p>
                    <a asp-area="Admin" asp-controller="InstructorsManagement" asp-action="Index" class="btn btn-primary mt-auto w-100">
                        Към Инструктори
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100 border-0">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <i class="fas fa-dumbbell fa-3x text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Управление на фитнес класове</h5>
                    <p class="card-text text-muted">Управлявайте груповите тренировки и техните детайли.</p>
                    <a asp-area="Admin" asp-controller="FitnessClassesManagement" asp-action="Index" class="btn btn-primary mt-auto w-100">
                        Към Фитнес класове
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100 border-0">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <i class="fas fa-calendar-alt fa-3x text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Управление на фитнес събития</h5>
                    <p class="card-text text-muted">Организирайте и управлявайте специални фитнес събития.</p>
                    <a asp-area="Admin" asp-controller="FitnessEventsManagement" asp-action="Index" class="btn btn-primary mt-auto w-100">
                        Към Фитнес събития
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100 border-0">
                <div class="card-body d-flex flex-column align-items-center text-center">
                    <i class="fas fa-spa fa-3x text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Управление на спа процедури</h5>
                    <p class="card-text text-muted">Създавайте, обновявайте или изтривайте спа услуги.</p>
                    <a asp-area="Admin" asp-controller="SpaProceduresManagement" asp-action="Index" class="btn btn-primary mt-auto w-100">
                        Към Спа процедури
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>