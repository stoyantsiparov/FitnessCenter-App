@model IEnumerable<FitnessCenterApp.Web.ViewModels.SpaProcedure.AllSpaProceduresViewModel>

@{
    ViewData["Title"] = "Manage Spa Procedures";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <a asp-action="Add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Procedure
        </a>
    </div>

    <div class="table-responsive shadow-sm pb-3">
        <table id="dataTable" class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 100px;">Image</th>
                    <th>Name</th>
                    <th>Capacity</th>
                    <th style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No spa procedures found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var procedure in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(procedure.ImageUrl))
                                {
                                    <img src="@procedure.ImageUrl" alt="@procedure.Name" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/img/no-image-available-02.jpg" alt="No image" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                            </td>
                            <td class="fw-bold">@procedure.Name</td>
                            <td class="text-center">@procedure.Capacity spots</td>
                            <td class="text-center">
                                <a asp-action="Participants" asp-route-id="@procedure.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-users"></i> Bookings
                                </a>
                                <a asp-action="Edit" asp-route-id="@procedure.Id" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@procedure.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
        $('#dataTable').DataTable({
        "paging": true,
        "ordering": true,
        "info": true,
        "order": [],
        "columnDefs": [
        { "orderable": false, "targets": [0, -1] }
        ]
        });
        });
    </script>
}