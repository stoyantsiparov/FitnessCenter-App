@model IEnumerable<FitnessCenterApp.Web.ViewModels.SpaProcedure.AllSpaProceduresViewModel>

@{
    ViewData["Title"] = "Управление на спа процедури";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Обратно към таблото
        </a>
        <div class="d-flex gap-2">
            <a asp-action="ExportSpaProceduresToCsv" class="btn btn-success">
                <i class="fas fa-file-csv"></i> Експорт (CSV)
            </a>
            <a asp-action="Add" class="btn btn-primary">
                <i class="fas fa-plus"></i> Добави нова процедура
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm pb-3">
        <table id="dataTable" class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 100px;">Снимка</th>
                    <th>Име</th>
                    <th>Капацитет</th>
                    <th style="min-width: 320px;">Действия</th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Не са намерени спа процедури.</td>
                    </tr>
                }
                else
                {
                    @foreach (var procedure in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(procedure.ImageUrl))
                                {
                                    <img src="@procedure.ImageUrl" alt="@procedure.Name" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/img/no-image-available-02.jpg" alt="Няма снимка" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                            </td>
                            <td class="fw-bold">@procedure.Name</td>
                            <td class="text-center">@procedure.Capacity места</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">
                                    <a asp-action="Participants" asp-route-id="@procedure.Id" class="btn btn-info btn-sm text-nowrap">
                                        <i class="fas fa-users"></i> Резервации
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@procedure.Id" class="btn btn-warning btn-sm text-nowrap">
                                        <i class="fas fa-edit"></i> Редактирай
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@procedure.Id" class="btn btn-danger btn-sm text-nowrap">
                                        <i class="fas fa-trash"></i> Изтрий
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
        $('#dataTable').DataTable({
        "paging": true,
        "ordering": true,
        "info": true,
        "order": [],
        "columnDefs": [
        { "orderable": false, "targets": [0, -1] }
        ],
        "language": {
        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/bg.json"
        }
        });
        });
    </script>
}