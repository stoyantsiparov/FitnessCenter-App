@model FitnessCenterApp.Web.ViewModels.MembershipType.EditMembershipTypeViewModel

@{
    ViewData["Title"] = "Edit Membership Type";
}

<div class="container mt-5 mb-5">
    <h1 class="text-primary mb-4">Edit Membership Type</h1>

    <form asp-action="Edit" method="post" id="editMembershipTypeForm">
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="Name" class="fw-bold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ImageUrl" class="fw-bold">Image URL</label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label asp-for="Price" class="fw-bold">Price</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="col-md-6 form-group mb-3">
                <label asp-for="Duration" class="fw-bold">Duration (in days)</label>
                <input asp-for="Duration" class="form-control" type="number" />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="fw-bold"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group d-flex justify-content-start mt-4">
            <button type="submit" class="btn btn-primary me-2" style="width: 200px;">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary" style="width: 200px;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("editMembershipTypeForm").onsubmit = function (event) {
            var price = parseFloat(document.querySelector("input[name='Price']").value);
            var duration = parseInt(document.querySelector("input[name='Duration']").value);

            if (price <= 0 || duration <= 0) {
                event.preventDefault();
                alert("Price and Duration must be positive values.");
            }
        };
    </script>
}