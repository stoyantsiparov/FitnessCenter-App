@model FitnessCenterApp.Web.ViewModels.FitnessClass.DeleteFitnessClassViewModel

@{
	ViewData["Title"] = "Delete Fitness Class";
}

<h2 class="text-center">@ViewData["Title"]</h2>
<hr />

<div class="row justify-content-center">
	<div class="col-md-6">
		<div class="card border-0 shadow">
			<div class="card-body">
				<h3 class="card-title text-center">@Model.Name</h3>
				<p class="mb-0"><strong>Description:</strong> @Model.Description</p>
				<p class="text-danger mt-3">Are you sure you want to delete this fitness class?</p>
			</div>
			<div class="card-footer bg-white border-0">
				<form asp-action="Delete" method="post">
					<input type="hidden" asp-for="Id" />
                    
					<button type="submit" class="btn btn-danger w-100 mb-2">Confirm Delete</button>
					<a asp-area="Admin" asp-controller="FitnessClassesManagement" asp-action="Index" class="btn btn-warning w-100">Cancel</a>
				</form>
			</div>
		</div>
	</div>
</div>