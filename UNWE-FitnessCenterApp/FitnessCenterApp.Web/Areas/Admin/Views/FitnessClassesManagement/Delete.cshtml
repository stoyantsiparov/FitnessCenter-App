@model FitnessCenterApp.Web.ViewModels.FitnessClass.DeleteFitnessClassViewModel

@{
	ViewData["Title"] = "Изтриване на фитнес клас";
}

<div class="container mt-5">
	<h2 class="text-center text-danger mb-4">@ViewData["Title"]</h2>
	<hr />

	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card border-0 shadow">
				<div class="card-body text-center">
					<i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
					<h3 class="card-title text-center">@Model.Name</h3>
					<p class="mb-0"><strong>Описание:</strong> @Model.Description</p>
					<p class="text-danger mt-3 fw-bold">Сигурни ли сте, че искате да изтриете този фитнес клас?</p>
				</div>
				<div class="card-footer bg-white border-0">
					<form asp-action="Delete" method="post">
						<input type="hidden" asp-for="Id" />
                        
						<button type="submit" class="btn btn-danger w-100 mb-2">
							<i class="fas fa-trash"></i> Да, изтрий
						</button>
						<a asp-area="Admin" asp-controller="FitnessClassesManagement" asp-action="Index" class="btn btn-warning w-100">
							<i class="fas fa-arrow-left"></i> Отказ
						</a>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>