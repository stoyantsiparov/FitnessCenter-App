@model FitnessCenterApp.Web.ViewModels.FitnessClass.AddFitnessClassViewModel

@{
    ViewData["Title"] = "Добавяне на фитнес клас";
}

<div class="container mt-5 mb-5">
    <h1 class="text-primary mb-4">Добавяне на нов фитнес клас</h1>

    <form asp-action="Add" method="post" id="addFitnessClassForm">
        <div class="form-group mb-3">
            <label asp-for="Name" class="fw-bold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ImageUrl" class="fw-bold">URL на снимка</label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="fw-bold"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 form-group mb-3">
                <label asp-for="Price" class="fw-bold">Цена (лв.)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group mb-3">
                <label asp-for="Duration" class="fw-bold">Продължителност (мин)</label>
                <input asp-for="Duration" class="form-control" type="number" />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group mb-3">
                <label asp-for="Capacity" class="fw-bold">Капацитет</label>
                <input asp-for="Capacity" class="form-control" type="number" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="InstructorId" class="fw-bold">Инструктор</label>
            <select asp-for="InstructorId" class="form-control">
                <option value="">Избери инструктор</option>
                @foreach (var instructor in Model.Instructors)
                {
                    <option value="@instructor.Id">@instructor.FirstName @instructor.LastName - @instructor.Specialization</option>
                }
            </select>
            <span asp-validation-for="InstructorId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Schedule" class="fw-bold">График (Дата и час)</label>
            <input asp-for="Schedule" class="form-control" type="datetime-local" />
            <span asp-validation-for="Schedule" class="text-danger"></span>
        </div>

        <div class="form-group d-flex justify-content-start mt-4">
            <button type="submit" class="btn btn-primary me-2" style="width: 200px;">Добави</button>
            <a asp-action="Index" class="btn btn-secondary" style="width: 200px;">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("addFitnessClassForm").onsubmit = function (event) {
            var scheduleInput = document.querySelector("input[name='Schedule']");

            if(scheduleInput && scheduleInput.value) {
                var schedule = new Date(scheduleInput.value);
                var today = new Date();

                if (schedule < today) {
                    event.preventDefault();
                    toastr.warning("Графикът трябва да бъде зададен за бъдеща дата.", "Внимание");
                }
            }
        };
    </script>
}