@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@model IEnumerable<FitnessCenterApp.Web.ViewModels.Admin.UserManagement.AllUsersViewModel>
@inject RoleManager<IdentityRole> roleManager

@{
    ViewData["Title"] = "Manage Users";
    var allRoles = await roleManager.Roles.Select(r => r.Name).ToListAsync();
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

    <div class="d-flex justify-content-start mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-dark text-center align-middle">
                <tr>
                    <th>Email</th>
                    <th>Current Roles</th>
                    <th style="width: 480px;">Actions</th>
                </tr>
            </thead>
            <tbody class="align-middle text-center">
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr style="height: 70px;">
                            <td class="fw-bold text-start ps-3">@user.Email</td>
                            <td>
                                @if (user.Roles != null && user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-info text-dark me-1" style="font-size: 0.9rem;">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No Roles</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">
                                    
                                    <form method="post" asp-action="AssignRole" asp-controller="UserManagement" asp-area="Admin" class="m-0 d-flex align-items-center">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="role" class="form-select form-select-sm me-1" style="width: 100px;">
                                            @foreach (var role in allRoles)
                                            {
                                                <option value="@role">@role</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-success btn-sm text-nowrap">Assign</button>
                                    </form>

                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        <form method="post" asp-action="RemoveRole" asp-controller="UserManagement" asp-area="Admin" class="m-0 d-flex align-items-center">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="role" class="form-select form-select-sm me-1" style="width: 100px;">
                                                @foreach (var role in user.Roles)
                                                {
                                                    <option value="@role">@role</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-warning btn-sm text-nowrap">Remove</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div style="width: 175px;"></div>
                                    }

                                    <form method="post" asp-action="DeleteUser" asp-controller="UserManagement" asp-area="Admin" class="m-0" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm text-nowrap">Delete</button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>