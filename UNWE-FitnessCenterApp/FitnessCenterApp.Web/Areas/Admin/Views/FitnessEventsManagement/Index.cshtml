@model IEnumerable<FitnessCenterApp.Web.ViewModels.FitnessEvent.AllFitnessEventsViewModel>

@{
    ViewData["Title"] = "Manage Fitness Events";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <a asp-action="Add" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Fitness Event
        </a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th style="width: 100px;">Image</th>
                    <th>Title</th>
                    <th>Location</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Capacity</th>
                    <th style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No fitness events found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var eventModel in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(eventModel.ImageUrl))
                                {
                                    <img src="@eventModel.ImageUrl" alt="@eventModel.Title" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/img/no-image-available-02.jpg" alt="No Image" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                            </td>
                            <td class="fw-bold">@eventModel.Title</td>
                            <td>@eventModel.Location</td>
                            <td class="text-center">@eventModel.StartDateTime</td>
                            <td class="text-center">@eventModel.EndDateTime</td>
                            <td class="text-center">@eventModel.Capacity</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@eventModel.Id" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@eventModel.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>