@model FitnessCenterApp.Web.ViewModels.FitnessEvent.FitnessEventDetailsViewModel

<div class="container mt-5 mb-5">
	<h2 class="text-center">@Model.Title</h2>
	<hr class="mb-4" />

	<div class="card shadow-sm mx-auto" style="max-width: 900px;">
		<div class="row g-0">
			<div class="col-md-5 d-flex align-items-center justify-content-center p-3">
				@if (!string.IsNullOrEmpty(Model.ImageUrl))
				{
					<img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Title" style="max-height: 400px; object-fit: cover;" />
				}
				else
				{
					<img src="~/img/no-image-available-02.jpg" class="img-fluid rounded" alt="Няма налична снимка" style="max-height: 400px; object-fit: cover;" />
				}
			</div>

			<div class="col-md-7">
				<div class="card-body d-flex flex-column h-100 p-4">
					<h4 class="card-title text-primary mb-3">Информация за събитието</h4>
                    
					<p class="card-text"><strong><i class="bi bi-geo-alt"></i> Местоположение:</strong> @Model.Location</p>
					<p class="card-text flex-grow-1"><strong>Описание:</strong> @Model.Description</p>
                    
					<div class="alert bg-sidecar border py-2 mb-4">
						<p class="mb-1"><strong>Начало:</strong> @Model.StartDateTime</p>
						<p class="mb-1"><strong>Край:</strong> @Model.EndDateTime</p>
						<p class="mb-0"><strong>Капацитет:</strong> @Model.Capacity места</p>
					</div>

					<div class="mt-auto d-flex gap-2">
						<form method="post" asp-action="AddToMyFitnessEvents" asp-route-id="@Model.Id" class="w-50">
							<button type="submit" class="btn btn-primary w-100">Запиши се</button>
						</form>
						<a asp-controller="FitnessEvent" asp-action="Index" class="btn btn-outline-secondary w-50">Назад към списъка</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}