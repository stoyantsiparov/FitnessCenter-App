@model FitnessCenterApp.Web.ViewModels.FitnessEvent.FitnessEventDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5 mb-5">
    <h2 class="text-center">@Model.Title</h2>
    <hr class="mb-4" />

    <div class="card shadow border-0 overflow-hidden mx-auto" style="max-width: 1000px;">
        <div class="row g-0">
            <div class="col-md-6 position-relative" style="min-height: 500px;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                }
                else
                {
                    <img src="~/img/no-image-available-02.jpg" alt="No image" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                }
            </div>

            <div class="col-md-6 p-4 d-flex flex-column">
                <h4 class="card-title text-primary mb-3">Информация за събитието</h4>

                <div class="flex-grow-1">
                    <p class="card-text text-muted" style="text-align: justify;">
                        <strong>Описание:</strong><br /> @Model.Description
                    </p>

                    <div class="alert bg-sidecar border-0 py-3 mb-4">
                        <p class="mb-2">
                            <i class="bi bi-geo-alt text-primary me-2"></i>
                            <strong>Местоположение:</strong> @Model.Location
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-calendar-event text-primary me-2"></i>
                            <strong>Начало:</strong> @Model.StartDateTime
                        </p>
                        <p class="mb-2">
                            <i class="bi bi-calendar-check text-primary me-2"></i>
                            <strong>Край:</strong> @Model.EndDateTime
                        </p>
                        <p class="mb-0">
                            <i class="bi bi-people text-primary me-2"></i>
                            <strong>Капацитет:</strong> @Model.Capacity места
                        </p>
                    </div>
                </div>

                <div class="mt-auto d-flex gap-2">
                    <form method="post" asp-action="AddToMyFitnessEvents" asp-route-id="@Model.Id" class="w-50">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Запиши се</button>
                    </form>
                    <a asp-controller="FitnessEvent" asp-action="Index" class="btn btn-outline-secondary w-50">Назад към списъка</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}