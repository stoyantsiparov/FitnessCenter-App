@model IEnumerable<FitnessCenterApp.Web.ViewModels.FitnessEvent.AllFitnessEventsViewModel>

@{
	ViewData["Title"] = "Моите фитнес събития";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-5" />

@if (!Model.Any())
{
	<div class="text-center">
		<h4 class="text-muted">Все още не сте се записали за никое събитие.</h4>
		<a asp-controller="FitnessEvent" asp-action="Index" class="btn btn-primary mt-3">Разгледай събитията</a>
	</div>
}
else
{
	<div class="row row-cols-1 row-cols-md-3 g-4">
		@foreach (var fitnessEvent in Model)
		{
			<div class="col">
				<div class="card h-100">
					@if (!string.IsNullOrEmpty(fitnessEvent.ImageUrl))
					{
						<img class="card-img-top" src="@fitnessEvent.ImageUrl" alt="@fitnessEvent.Title" style="height: 200px; object-fit: cover;">
					}
					else
					{
						<img class="card-img-top" src="~/img/no-image-available-02.jpg" alt="Няма налична снимка" style="height: 200px; object-fit: cover;">
					}

					<div class="card-body d-flex flex-column">
						<h5 class="card-title text-center text-primary">@fitnessEvent.Title</h5>
						<hr class="mt-2 mb-3" />

						<p class="card-text flex-grow-1 text-center">
							<strong><i class="bi bi-geo-alt"></i> Местоположение:</strong><br /> @fitnessEvent.Location
						</p>
                        
						<div class="alert bg-sidecar border text-center py-2 mb-3" style="font-size: 0.9rem;">
							<strong>Начало:</strong> @fitnessEvent.StartDateTime<br />
							<strong>Край:</strong> @fitnessEvent.EndDateTime
						</div>

						<div class="mt-auto">
							<form method="post" asp-action="RemoveFromMyFitnessEvents" asp-route-id="@fitnessEvent.Id">
								<button type="submit" class="btn btn-danger w-100">Отмени регистрацията</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}