@using System.Security.Claims
@using System.Globalization
@using static FitnessCenterApp.Common.EntityValidationConstants
@model FitnessCenterApp.Web.ViewModels.FitnessEvent.PaginatedFitnessEventsViewModel

@{
    ViewData["Title"] = "Налични фитнес събития";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-4" />

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Archive" class="btn btn-outline-info">Виж архив на приключилите събития</a>
</div>

<form method="get" asp-controller="FitnessEvent" asp-action="Index" class="mb-5 bg-white p-4 rounded shadow-sm border">
    <div class="row g-3">
        <div class="col-md-6">
            <input type="text" name="searchQuery" class="form-control" value="@Model.SearchQuery" placeholder="Търсене по име или локация..." />
        </div>
        <div class="col-md-3">
            <select name="sortOrder" class="form-select">
                <option value="">Сортирай по...</option>
                <option value="date_asc" selected="@(ViewData["CurrentSort"]?.ToString() == "date_asc")">Най-ранни</option>
                <option value="date_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "date_desc")">Най-късни</option>
                <option value="title_asc" selected="@(ViewData["CurrentSort"]?.ToString() == "title_asc")">Име (А-Я)</option>
                <option value="title_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "title_desc")">Име (Я-А)</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Търси</button>
            <a asp-controller="FitnessEvent" asp-action="Index" class="btn btn-outline-secondary w-100">Изчисти</a>
        </div>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var fitnessEvent in Model.FitnessEvents)
    {
        bool isExpired = DateTime.ParseExact(fitnessEvent.EndDateTime, FitnessEvent.DateTimeFormat, CultureInfo.InvariantCulture) < DateTime.Now;
        bool isRegistered = currentUserId != null && fitnessEvent.UserIds != null && fitnessEvent.UserIds.Contains(currentUserId);
        bool isDisabled = isExpired || isRegistered;

        <div class="col">
            <div class="card h-100 shadow-sm @(isDisabled ? "opacity-75" : "")" style="@(isDisabled ? "filter: grayscale(100%);" : "")">
                @if (!string.IsNullOrEmpty(fitnessEvent.ImageUrl))
                {
                    <img class="card-img-top" src="@fitnessEvent.ImageUrl" alt="@fitnessEvent.Title" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <img class="card-img-top" src="~/img/no-image-available-02.jpg" alt="Няма налична снимка" style="height: 200px; object-fit: cover;">
                }

                <div class="card-body d-flex flex-column">
                    <div class="text-center mb-2">
                        <h5 class="card-title text-primary fw-bold mb-1">@fitnessEvent.Title</h5>
                        @if (isRegistered)
                        {
                            <span class="badge bg-success mt-1">ЗАПИСАН</span>
                        }
                        else if (isExpired)
                        {
                            <span class="badge bg-danger mt-1">ПРИКЛЮЧИЛО</span>
                        }
                    </div>

                    <hr class="mt-2 mb-3" />

                    <p class="card-text flex-grow-1 text-center">
                        <strong><i class="bi bi-geo-alt"></i> Местоположение:</strong><br /> @fitnessEvent.Location
                    </p>

                    <div class="alert bg-sidecar border text-center py-2 mb-3" style="font-size: 0.9rem;">
                        <strong>Начало:</strong> @fitnessEvent.StartDateTime<br />
                        <strong>Край:</strong> @fitnessEvent.EndDateTime<br />
                        <strong><i class="bi bi-people"></i> Места:</strong> @fitnessEvent.Capacity
                    </div>

                    <div class="mt-auto d-flex flex-column gap-2">
                        @if (isRegistered)
                        {
                            <button class="btn btn-secondary w-100" disabled>Вече сте записани</button>
                        }
                        else if (!isExpired)
                        {
                            <form method="post" asp-controller="FitnessEvent" asp-action="AddToMyFitnessEvents" asp-route-id="@fitnessEvent.Id">
                                <button type="submit" class="btn btn-primary w-100">Запиши се</button>
                            </form>
                            <a asp-controller="FitnessEvent" asp-action="Details" asp-route-id="@fitnessEvent.Id" class="btn btn-outline-primary w-100">Виж детайли</a>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled>Събитието изтече</button>
                            <a href="javascript:void(0)" class="btn btn-outline-secondary w-100 disabled" style="pointer-events: none;">Детайли (Заключени)</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortOrder="@ViewData["CurrentSort"]">Предишна</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortOrder="@ViewData["CurrentSort"]">Следваща</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}