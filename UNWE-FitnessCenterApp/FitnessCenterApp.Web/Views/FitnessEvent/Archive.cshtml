@model IEnumerable<FitnessCenterApp.Web.ViewModels.FitnessEvent.AllFitnessEventsViewModel>

@{
	ViewData["Title"] = "Архив на фитнес събития";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-4" />

<div class="d-flex justify-content-start mb-3">
	<a asp-action="Index" class="btn btn-secondary">Обратно към активните</a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
	@foreach (var fitnessEvent in Model)
	{
		<div class="col">
			<div class="card h-100 shadow-sm bg-light">
				<img class="card-img-top" src="@(string.IsNullOrEmpty(fitnessEvent.ImageUrl) ? "/img/no-image-available-02.jpg" : fitnessEvent.ImageUrl)" style="height: 200px; object-fit: cover;">
				<div class="card-body text-center">
					<h5 class="card-title text-primary">@fitnessEvent.Title</h5>
					<p class="text-muted"><strong>Край:</strong> @fitnessEvent.EndDateTime</p>
					<span class="badge bg-secondary">ПРИКЛЮЧИЛО</span>
				</div>
			</div>
		</div>
	}
</div>