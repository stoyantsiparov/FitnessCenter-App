@model FitnessCenterApp.Web.ViewModels.SpaProcedure.PaginatedSpaProceduresViewModel

@{
	ViewData["Title"] = "Available Spa Procedures";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-4" />

<form method="get" asp-controller="SpaProcedure" asp-action="Index" class="mb-5 bg-white p-4 rounded shadow-sm" style="border: 1px solid #8697C4;">
	<div class="row g-3">
		<div class="col-md-6">
			<input type="text" name="searchQuery" class="form-control" value="@Model.SearchQuery" placeholder="Search procedures..." />
		</div>
		<div class="col-md-3">
			<select name="sortOrder" class="form-select">
				<option value="">Sort by...</option>
				<option value="name_asc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_asc")">Name (A-Z)</option>
				<option value="name_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_desc")">Name (Z-A)</option>
			</select>
		</div>
		<div class="col-md-3 d-flex gap-2">
			<button type="submit" class="btn btn-primary w-100">Search</button>
			<a asp-controller="SpaProcedure" asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
		</div>
	</div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
	@foreach (var procedure in Model.SpaProcedures)
	{
		<div class="col">
			<div class="card h-100" style="border-color: #8697C4;">
				@if (!string.IsNullOrEmpty(procedure.ImageUrl))
				{
					<img class="card-img-top" src="@procedure.ImageUrl" alt="@procedure.Name" style="height: 200px; object-fit: cover;">
				}
				else
				{
					<img class="card-img-top" src="~/img/no-image-available-02.jpg" alt="No Image Available" style="height: 200px; object-fit: cover;">
				}

				<div class="card-body d-flex flex-column">
					<h5 class="card-title text-center text-primary">@procedure.Name</h5>
					<hr class="mt-2 mb-3" />

					<p class="card-text flex-grow-1 text-center">
						@procedure.Description
					</p>

					<div class="alert text-center py-2 mb-3" style="background-color: #EDE8F5; border-color: #ADBBDA; font-size: 0.9rem;">
						<strong><i class="bi bi-people"></i> Capacity:</strong> @procedure.Capacity spots
					</div>

					<div class="mt-auto d-flex flex-column gap-2">
						<a asp-controller="SpaProcedure" asp-action="Details" asp-route-id="@procedure.Id" class="btn btn-primary w-100">Book Procedure</a>
					</div>
				</div>
			</div>
		</div>
	}
</div>

@if (Model.TotalPages > 1)
{
	<nav aria-label="Page navigation" class="mt-5">
		<ul class="pagination justify-content-center">
			@if (Model.HasPreviousPage)
			{
				<li class="page-item">
					<a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortOrder="@ViewData["CurrentSort"]">Previous</a>
				</li>
			}

			@for (int i = 1; i <= Model.TotalPages; i++)
			{
				<li class="page-item @(i == Model.PageNumber ? "active" : "")">
					<a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
				</li>
			}

			@if (Model.HasNextPage)
			{
				<li class="page-item">
					<a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a>
				</li>
			}
		</ul>
	</nav>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}