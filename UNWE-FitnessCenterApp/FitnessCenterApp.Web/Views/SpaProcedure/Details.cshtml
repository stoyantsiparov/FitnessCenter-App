@model FitnessCenterApp.Web.ViewModels.SpaProcedure.SpaProcedureDetailsViewModel

<div class="container mt-5 mb-5">
	<h2 class="text-center">@Model.Name</h2>
	<hr class="mb-4" />

	<div class="card shadow-sm mx-auto" style="max-width: 900px;">
		<div class="row g-0">
			<div class="col-md-5 d-flex align-items-center justify-content-center p-3">
				@if (!string.IsNullOrEmpty(Model.ImageUrl))
				{
					<img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" style="max-height: 400px; object-fit: cover;" />
				}
				else
				{
					<img src="~/img/no-image-available-02.jpg" class="img-fluid rounded" alt="Няма налична снимка" style="max-height: 400px; object-fit: cover;" />
				}
			</div>

			<div class="col-md-7">
				<div class="card-body d-flex flex-column h-100 p-4">
					<h4 class="card-title text-primary mb-3">Информация за процедурата</h4>
                    
					<p class="card-text flex-grow-1"><strong>Описание:</strong><br /> @Model.Description</p>
                    
					<div class="alert bg-sidecar border py-2 mb-4">
						<p class="mb-1"><strong><i class="bi bi-tag"></i> Цена:</strong> @Model.Price.ToString("C")</p>
						<p class="mb-1"><strong><i class="bi bi-clock"></i> Продължителност:</strong> @Model.Duration минути</p>
						<p class="mb-0"><strong><i class="bi bi-people"></i> Капацитет:</strong> @Model.Capacity места</p>
					</div>

					<div class="mt-auto">
						<form method="post" asp-action="AddToMySpaAppointments" asp-route-id="@Model.Id" class="bg-sidecar border p-3 rounded mb-3">
							<div class="form-group mb-3">
								<label for="appointmentDateTime" class="form-label fw-bold">Изберете дата и час за резервация:</label>
								<input type="datetime-local" name="appointmentDateTime" id="appointmentDateTime" class="form-control" required />
								<span class="text-danger" id="timeErrorSpan"></span>
							</div>
                            
							<button type="submit" class="btn btn-primary w-100 fw-bold">Резервирай</button>
						</form>
						<a asp-controller="SpaProcedure" asp-action="Index" class="btn btn-outline-secondary w-100">Назад към списъка</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script>
		// Get current date and time
		var today = new Date();

		// Remove timezone offset to format correctly in local time
		today.setMinutes(today.getMinutes() - today.getTimezoneOffset());

		// Set the min attribute for the input to today's date
		var minDate = today.toISOString().slice(0, 16);
		document.getElementById("appointmentDateTime").setAttribute("min", minDate);

		// Get the date 7 days from today
		var maxDateObj = new Date();
		maxDateObj.setDate(maxDateObj.getDate() + 7);
		maxDateObj.setMinutes(maxDateObj.getMinutes() - maxDateObj.getTimezoneOffset());

		var maxDate = maxDateObj.toISOString().slice(0, 16);
		document.getElementById("appointmentDateTime").setAttribute("max", maxDate);

		document.getElementById("appointmentDateTime").closest("form").addEventListener("submit", function (e) {
			var errorSpan = document.getElementById("timeErrorSpan");
			errorSpan.innerText = "";

			if (document.getElementById("appointmentDateTime").value) {
				var selectedDate = new Date(document.getElementById("appointmentDateTime").value);
				var hours = selectedDate.getHours();
				var minutes = selectedDate.getMinutes();

				if (hours < 9 || hours > 18 || (hours === 18 && minutes > 0)) {
					e.preventDefault();
                    
					toastr.warning("Часовете трябва да бъдат в рамките на работното време (09:00 - 18:00).");
					errorSpan.innerText = "Моля, изберете валиден час между 09:00 и 18:00.";
				}
			}
		});
	</script>
}