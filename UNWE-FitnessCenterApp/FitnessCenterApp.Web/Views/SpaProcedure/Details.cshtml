@model FitnessCenterApp.Web.ViewModels.SpaProcedure.SpaProcedureDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5 mb-5">
    <h2 class="text-center">@Model.Name</h2>
    <hr class="mb-4" />

    <div class="card shadow border-0 overflow-hidden mx-auto" style="max-width: 1000px;">
        <div class="row g-0">
            <div class="col-md-6 position-relative" style="min-height: 500px;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                }
                else
                {
                    <img src="~/img/no-image-available-02.jpg" alt="No image" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                }
            </div>

            <div class="col-md-6 p-4 d-flex flex-column">
                <h4 class="card-title text-primary mb-3">Информация за процедурата</h4>

                <div class="flex-grow-1">
                    <p class="card-text text-muted" style="text-align: justify;">
                        <strong>Описание:</strong><br /> @Model.Description
                    </p>

                    <div class="alert bg-sidecar border-0 py-3 mb-4">
                        <p class="mb-2"><strong><i class="bi bi-tag"></i> Цена:</strong> @Model.Price.ToString("C")</p>
                        <p class="mb-2"><strong><i class="bi bi-clock"></i> Продължителност:</strong> @Model.Duration минути</p>
                        <p class="mb-0"><strong><i class="bi bi-people"></i> Капацитет:</strong> @Model.Capacity места</p>
                    </div>
                </div>

                <div class="mt-auto">
                    <form method="post" asp-action="AddToMySpaAppointments" asp-route-id="@Model.Id" class="bg-sidecar border-0 p-3 rounded mb-3 shadow-sm">
                        <div class="form-group mb-3">
                            <label for="appointmentDateTime" class="form-label fw-bold">Изберете дата и час за резервация:</label>
                            <input type="datetime-local" name="appointmentDateTime" id="appointmentDateTime" class="form-control border-0" required />
                            <span class="text-danger" id="timeErrorSpan"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold mb-2">Резервирай</button>
                    </form>
                    <a asp-controller="SpaProcedure" asp-action="Index" class="btn btn-outline-secondary w-100">Назад към списъка</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var today = new Date();
        today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
        var minDate = today.toISOString().slice(0, 16);
        document.getElementById("appointmentDateTime").setAttribute("min", minDate);

        var maxDateObj = new Date();
        maxDateObj.setDate(maxDateObj.getDate() + 7);
        maxDateObj.setMinutes(maxDateObj.getMinutes() - maxDateObj.getTimezoneOffset());
        var maxDate = maxDateObj.toISOString().slice(0, 16);
        document.getElementById("appointmentDateTime").setAttribute("max", maxDate);

        document.getElementById("appointmentDateTime").closest("form").addEventListener("submit", function (e) {
            var errorSpan = document.getElementById("timeErrorSpan");
            errorSpan.innerText = "";
            if (document.getElementById("appointmentDateTime").value) {
                var selectedDate = new Date(document.getElementById("appointmentDateTime").value);
                var hours = selectedDate.getHours();
                var minutes = selectedDate.getMinutes();
                if (hours < 9 || hours > 18 || (hours === 18 && minutes > 0)) {
                    e.preventDefault();
                    toastr.warning("Часовете трябва да бъдат в рамките на работното време (09:00 - 18:00).");
                    errorSpan.innerText = "Изберете валиден час между 09:00 и 18:00.";
                }
            }
        });
    </script>
}