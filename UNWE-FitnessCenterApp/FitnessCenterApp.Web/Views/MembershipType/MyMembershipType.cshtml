@model IEnumerable<FitnessCenterApp.Web.ViewModels.MembershipType.AllMembershipTypeViewModel>

@{
	ViewData["Title"] = "Моят активен абонамент";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-5" />

@if (Model != null && Model.Any())
{
	<div class="row g-4 justify-content-center">
		@foreach (var membership in Model)
		{
			<div class="col-auto">
				<div class="card h-100 shadow-sm" style="width: 22rem; overflow: hidden;">

					<div class="text-center pt-4 pb-2 bg-white">
						<h4 class="card-title text-primary fw-bold mb-0">@membership.Name</h4>
					</div>

					@if (!string.IsNullOrEmpty(membership.ImageUrl))
					{
						<img src="@membership.ImageUrl" alt="@membership.Name" style="height: 220px; width: 100%; object-fit: cover;">
					}
					else
					{
						<img src="~/img/no-image-available-02.jpg" alt="Няма налична снимка" style="height: 220px; width: 100%; object-fit: cover;">
					}

					<div class="card-body d-flex flex-column text-center">
						<div class="alert bg-sidecar border py-3 mb-4 mt-2" style="border-radius: 10px;">
							<p class="mb-2 text-dark fs-6">Обща продължителност: @membership.Duration дни</p>

							<hr class="my-2" style="border-color: rgba(0,0,0,0.1);" />

							@if (membership.DaysRemaining > 5)
							{
								<p class="mb-0 text-success fs-5 fw-bold"><i class="bi bi-clock-history me-1"></i> Остават: @membership.DaysRemaining дни</p>
							}
							else if (membership.DaysRemaining > 0 && membership.DaysRemaining <= 5)
							{
								<p class="mb-0 text-warning fs-5 fw-bold"><i class="bi bi-exclamation-circle me-1"></i> Остават само: @membership.DaysRemaining дни!</p>
							}
							else
							{
								<p class="mb-0 text-danger fs-5 fw-bold"><i class="bi bi-x-circle me-1"></i> Абонаментът е изтекъл</p>
							}
						</div>

						<div class="mt-auto d-flex flex-column gap-2">
							<form id="cancelForm-@membership.Id" method="post" asp-action="RemoveMyMembership" asp-route-id="@membership.Id">
								<button type="button" class="btn btn-danger w-100 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#cancelModal-@membership.Id">
									ПРЕКРАТИ АБОНАМЕНТА
								</button>
							</form>
							<a asp-controller="MembershipType" asp-action="Details" asp-route-id="@membership.Id" class="btn btn-outline-primary w-100 py-2">ВИЖ ДЕТАЙЛИ</a>
						</div>
					</div>
				</div>
			</div>

			<div class="modal fade" id="cancelModal-@membership.Id" tabindex="-1" aria-labelledby="cancelModalLabel-@membership.Id" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">
						<div class="modal-header bg-danger text-white">
							<h5 class="modal-title text-white" id="cancelModalLabel-@membership.Id"><i class="bi bi-exclamation-triangle-fill me-2"></i>Прекратяване на абонамент</h5>
							<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body text-start">
							<p class="fs-5 mb-3">Сигурни ли сте, че искате да прекратите своя план <strong>@membership.Name</strong>?</p>
							<div class="alert alert-warning mb-0" style="border-left: 5px solid #ffc107;">
								<strong>Внимание:</strong> Ще загубите достъп незабавно и това действие не може да бъде отменено.
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Назад</button>
							<button type="button" class="btn btn-danger fw-bold" onclick="document.getElementById('cancelForm-@membership.Id').submit();">Да, прекрати го</button>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}
else
{
	<div class="text-center mt-5">
		<i class="bi bi-card-checklist text-muted" style="font-size: 4rem;"></i>
		<h4 class="text-muted mt-3">В момента нямате активен абонамент.</h4>
		<a asp-action="Index" class="btn btn-primary mt-3 px-5 py-2 fw-bold">РАЗГЛЕДАЙ ПЛАНОВЕТЕ</a>
	</div>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}