@{
    ViewData["Title"] = "Начална страница";
    ViewData["Message"] = "Добре дошли в УНСС Фитнес Център!";
}

<div class="container text-center py-5">
    <h2>@ViewData["Message"]</h2>
    <h3 class="text-muted mb-4">Постигнете своите фитнес цели с нас</h3>

    <p class="lead">Разгледайте нашите фитнес и спа услуги.</p>
    <p class="lead">Запишете се за групови тренировки и резервирайте време за релакс.</p>

    <div class="d-flex justify-content-center mb-5 mt-4">
        <a asp-controller="MembershipType" asp-action="Index" class="btn btn-primary btn-lg px-5">Стани член</a>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="https://m.media-amazon.com/images/I/51Cg14ozwBL._AC_UF894,1000_QL80_.jpg" class="card-img-top img-fluid" alt="Фитнес класове" style="height: 250px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Фитнес класове</h5>
                    <p class="card-text flex-grow-1">Включете се в тренировка, която отговаря на вашия график и цели.</p>
                    <a asp-controller="FitnessClass" asp-action="Index" class="btn btn-primary w-100 mt-3">Научи повече</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="https://thebeautyisland.co.uk/wp-content/uploads/2021/03/The-Beauty-Island-spa-treatments-18-1.jpg" class="card-img-top img-fluid" alt="Спа процедури" style="height: 250px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Спа процедури</h5>
                    <p class="card-text flex-grow-1">Отпуснете се с нашите премиум спа процедури и масажи.</p>
                    <a asp-controller="SpaProcedure" asp-action="Index" class="btn btn-primary w-100 mt-3">Научи повече</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="https://png.pngtree.com/thumb_back/fh260/background/20190223/ourmid/pngtree-color-tennis-sport-advertising-background-backgroundmotionwork-outtennistreeshand-paintedfreshhouses-image_75815.jpg" class="card-img-top img-fluid" alt="Фитнес събития" style="height: 250px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Фитнес събития</h5>
                    <p class="card-text flex-grow-1">Присъединете се към нашите спортни събития на открито.</p>
                    <a asp-controller="FitnessEvent" asp-action="Index" class="btn btn-primary w-100 mt-3">Научи повече</a>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mt-5 mb-4">Отзиви от клиенти</h2>
    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card h-100 bg-sidecar border shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center">
                    <p><strong>"Това е най-доброто фитнес приложение! Помогна ми да вляза във форма!"</strong></p>
                    <p><span class="stars text-warning fs-5">★★★★★</span></p>
                    <footer class="mt-auto">- Мария Иванова, <cite title="Source Title">Фитнес ентусиаст</cite></footer>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 bg-sidecar border shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center">
                    <p><strong>"Инструкторите са невероятни! Постигнах повече за няколко месеца тук, отколкото предполагах."</strong></p>
                    <p><span class="stars text-warning fs-5">★★★★★</span></p>
                    <footer class="mt-auto">- Иван Петров, <cite title="Source Title">Лоялен клиент</cite></footer>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 bg-sidecar border shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center">
                    <p><strong>"Обожавам разнообразието от класове и спа терапиите. Най-доброто фитнес изживяване!"</strong></p>
                    <p><span class="stars text-warning fs-5">★★★★★</span></p>
                    <footer class="mt-auto">- Елена Георгиева, <cite title="Source Title">Редовен посетител</cite></footer>
                </div>
            </div>
        </div>
    </div>
</div>