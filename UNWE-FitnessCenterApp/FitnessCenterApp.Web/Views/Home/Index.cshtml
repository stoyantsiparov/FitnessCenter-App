@{
    ViewData["Title"] = "Начална страница";
    ViewData["Message"] = "Добре дошли в УНСС Фитнес Център!";
}

<div class="container text-center py-5">
    <h2>@ViewData["Message"]</h2>
    <h3 class="text-muted mb-4">Постигнете своите фитнес цели с нас</h3>

    <p class="lead">Разгледайте нашите фитнес и спа услуги.</p>
    <div class="d-flex justify-content-center mb-5 mt-4">
        <a asp-controller="MembershipType" asp-action="Index" class="btn btn-primary btn-lg px-5">Стани член</a>
    </div>

    <div class="row mt-5">
	    <div class="col-md-4 mb-4">
		    <div class="card h-100">
			    <img src="https://m.media-amazon.com/images/I/51Cg14ozwBL._AC_UF894,1000_QL80_.jpg" class="card-img-top img-fluid" alt="Фитнес класове" style="height: 250px; object-fit: cover;">
			    <div class="card-body"><h5 class="card-title">Фитнес класове</h5><a asp-controller="FitnessClass" asp-action="Index" class="btn btn-primary w-100">Научи повече</a></div>
		    </div>
	    </div>

        <div class="col-md-4 mb-4">
	        <div class="card h-100">
		        <img src="https://thebeautyisland.co.uk/wp-content/uploads/2021/03/The-Beauty-Island-spa-treatments-18-1.jpg" class="card-img-top img-fluid" alt="Спа процедури" style="height: 250px; object-fit: cover;">
		        <div class="card-body"><h5 class="card-title">Спа процедури</h5><a asp-controller="SpaProcedure" asp-action="Index" class="btn btn-primary w-100">Научи повече</a></div>
	        </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="https://png.pngtree.com/thumb_back/fh260/background/20190223/ourmid/pngtree-color-tennis-sport-advertising-background-backgroundmotionwork-outtennistreeshand-paintedfreshhouses-image_75815.jpg" class="card-img-top img-fluid" alt="Фитнес събития" style="height: 250px; object-fit: cover;">
                <div class="card-body"><h5 class="card-title">Фитнес събития</h5><a asp-controller="FitnessEvent" asp-action="Index" class="btn btn-primary w-100">Научи повече</a></div>
            </div>
        </div>
    </div>

    <div class="row mt-5 py-5 bg-white border-top border-bottom">
	    <h2 class="mb-5 text-uppercase fw-bold" style="color: #A22E43;">Нашата статистика</h2>
    
	    <div class="row g-4">
		    <div class="col-md-3">
			    <div class="p-3 border rounded shadow-sm h-100 transition-hover">
				    <i class="bi bi-people-fill fs-1 mb-3" style="color: #A22E43;"></i>
				    <h3 class="fw-bold">@ViewBag.MembersCount</h3>
				    <p class="text-muted mb-0">Активни членове</p>
			    </div>
		    </div>

		    <div class="col-md-3">
			    <div class="p-3 border rounded shadow-sm h-100 transition-hover">
				    <i class="bi bi-calendar-check-fill fs-1 mb-3" style="color: #A22E43;"></i>
				    <h3 class="fw-bold">@ViewBag.ClassesCount</h3>
				    <p class="text-muted mb-0">Фитнес класа</p>
			    </div>
		    </div>

		    <div class="col-md-3">
			    <div class="p-3 border rounded shadow-sm h-100 transition-hover">
				    <i class="bi bi-trophy-fill fs-1 mb-3" style="color: #A22E43;"></i>
				    <h3 class="fw-bold">@ViewBag.EventsCount</h3>
				    <p class="text-muted mb-0">Спортни събития</p>
			    </div>
		    </div>

		    <div class="col-md-3">
			    <div class="p-3 border rounded shadow-sm h-100 transition-hover">
				    <i class="bi bi-water fs-1 mb-3" style="color: #A22E43;"></i>
				    <h3 class="fw-bold">@ViewBag.SpaCount</h3>
				    <p class="text-muted mb-0">СПА процедури</p>
			    </div>
		    </div>
	    </div>
    </div>
</div>