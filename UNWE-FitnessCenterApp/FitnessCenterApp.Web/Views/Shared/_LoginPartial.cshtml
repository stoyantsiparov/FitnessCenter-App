@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav d-flex flex-row align-items-center mb-0 gap-3">
	@if (SignInManager.IsSignedIn(User))
	{
		<li class="nav-item">
			<a class="nav-link text-white m-0 p-0" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Здравейте, @User.Identity?.Name!</a>
		</li>
		<li class="nav-item">
			<form class="form-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
				<button type="submit" class="btn btn-outline-light btn-sm fw-bold">Изход</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-white m-0 p-0" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-white m-0 p-0" asp-area="Identity" asp-page="/Account/Login">Вход</a>
		</li>
	}
</ul>