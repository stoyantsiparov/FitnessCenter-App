@using static FitnessCenterApp.Common.ApplicationsConstants
@{
	int currentYear = DateTime.UtcNow.Year;
	string footerNote = (ReleaseYear == currentYear) ?
		$"{ReleaseYear}" : $"{ReleaseYear} - {currentYear}";

	string projectName = "УНСС Фитнес Център";
}
<!DOCTYPE html>
<html lang="bg">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - @projectName</title>
	<link rel="icon" type="image/x-icon" href="~/favicon.ico" />
	<link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/FitnessCenterApp.Web.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
</head>
<body>
	<header class="unwe-header box-shadow sticky-top mb-4">
		<div class="unwe-top-bar py-2">
			<div class="container-fluid d-flex flex-wrap justify-content-between align-items-center">
				<a class="navbar-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
					<img src="~/img/logo-long-bg.png" alt="УНСС Лого" style="height: 45px; object-fit: contain;" />
				</a>

				<div class="d-flex align-items-center gap-3 ms-auto mt-2 mt-sm-0">
					@if (User.IsInRole(AdminRole))
					{
						<a class="btn btn-outline-light btn-sm fw-bold" asp-area="Admin" asp-controller="Home" asp-action="Index">
							Админ панел
						</a>
					}
					<partial name="_LoginPartial" />
				</div>
			</div>
		</div>

		<nav class="navbar navbar-expand-sm navbar-dark unwe-bottom-nav py-0">
			<div class="container-fluid">
				<button class="navbar-toggler ms-auto my-2 border-white text-white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-start">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link text-white px-3 py-3" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
						</li>

						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle text-white px-3 py-3" id="buyMembershipDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Членство
							</a>
							<ul class="dropdown-menu unwe-dropdown" aria-labelledby="buyMembershipDropdown">
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="MembershipType" asp-action="Index">Цени и планове</a></li>
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="MembershipType" asp-action="MyMembershipType">Моят абонамент</a></li>
							</ul>
						</li>

						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle text-white px-3 py-3" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Услуги
							</a>
							<ul class="dropdown-menu unwe-dropdown" aria-labelledby="servicesDropdown">
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="FitnessClass" asp-action="Index">Фитнес класове</a></li>
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="FitnessEvent" asp-action="Index">Фитнес събития</a></li>
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="SpaProcedure" asp-action="Index">Спа процедури</a></li>
							</ul>
						</li>

						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle text-white px-3 py-3" id="appointmentsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Резервации
							</a>
							<ul class="dropdown-menu unwe-dropdown" aria-labelledby="appointmentsDropdown">
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="FitnessClass" asp-action="MyClasses">Фитнес класове</a></li>
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="FitnessEvent" asp-action="MyFitnessEvents">Фитнес събития</a></li>
								<li><a asp-area="" class="dropdown-item text-white" asp-controller="SpaProcedure" asp-action="MySpaAppointments">Спа процедури</a></li>
							</ul>
						</li>

						<li class="nav-item">
							<a asp-area="" class="nav-link text-white px-3 py-3" asp-controller="Instructor" asp-action="Index">Нашите инструктори</a>
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>

	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

<footer class="footer bg-white py-3 border-top" style="border-top-color: #E0E0E0 !important;">
	<div class="container-fluid px-4">
		<div class="row align-items-center">
            
			<div class="col-md-4 text-center text-md-start mb-2 mb-md-0">
				<span class="text-primary fw-bold">Стоян Ципаров - 22180022</span>
			</div>

			<div class="col-md-4 text-center mb-2 mb-md-0">
				<span class="text-primary fw-bold">&copy; @footerNote - @projectName</span>
				<a href="https://github.com/stoyantsiparov" target="_blank" class="text-dark fs-5 mx-1" title="GitHub"><i class="bi bi-github"></i></a>
				<a href="https://www.linkedin.com/in/stoyan-tsiparov-53286a1a5/" target="_blank" class="text-dark fs-5 mx-1" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
			</div>

			<div class="col-md-4 text-center text-md-end">
				<span class="text-primary fw-bold">
					Дизайн, вдъхновен от 
					<a href="https://www.unwe.bg" target="_blank" style="color: #A22E43; font-weight: bold; text-decoration: none;">УНСС</a>
				</span>
			</div>

		</div>
	</div>
</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>
		toastr.options = {
		"closeButton": true,
		"progressBar": true,
		"positionClass": "toast-bottom-right",
		"timeOut": "5000"
		};

		var successMessage = '@Html.Raw(TempData["SuccessMessage"])';
		var errorMessage = '@Html.Raw(TempData["ErrorMessage"])';

		if (successMessage && successMessage !== '') {
		toastr.success(successMessage, "Успех");
		}

		if (errorMessage && errorMessage !== '') {
		toastr.error(errorMessage, "Грешка");
		}
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>