@using System.Globalization
@using static FitnessCenterApp.Common.EntityValidationConstants
@model FitnessCenterApp.Web.ViewModels.FitnessClass.PaginatedFitnessClassesViewModel

@{
	ViewData["Title"] = "Налични фитнес класове";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-4" />

<form method="get" asp-controller="FitnessClass" asp-action="Index" class="mb-5 bg-white p-4 rounded shadow-sm border">
	<div class="row g-3">
		<div class="col-md-3">
			<input type="text" name="searchQuery" class="form-control" value="@Model.SearchQuery" placeholder="Търсене на класове..." />
		</div>
		<div class="col-md-2">
			<input type="number" name="minDuration" class="form-control" value="@Model.MinDuration" placeholder="Мин. минути" />
		</div>
		<div class="col-md-2">
			<input type="number" name="maxDuration" class="form-control" value="@Model.MaxDuration" placeholder="Макс. минути" />
		</div>
		<div class="col-md-3">
			<select name="sortOrder" class="form-select">
				<option value="">Сортирай по...</option>
				<option value="name_asc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_asc")">Име (А-Я)</option>
				<option value="name_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_desc")">Име (Я-А)</option>
				<option value="duration_asc" selected="@(ViewData["CurrentSort"]?.ToString() == "duration_asc")">Най-кратки</option>
				<option value="duration_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "duration_desc")">Най-дълги</option>
			</select>
		</div>
		<div class="col-md-2 d-flex gap-2">
			<button type="submit" class="btn btn-primary w-100">Търси</button>
			<a asp-controller="FitnessClass" asp-action="Index" class="btn btn-outline-secondary w-100">Изчисти</a>
		</div>
	</div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
	@foreach (var fitnessClass in Model.FitnessClasses)
	{
		bool isExpired = DateTime.ParseExact(fitnessClass.Schedule, FitnessClass.ScheduleDateTimeFormat, CultureInfo.InvariantCulture).AddMinutes(fitnessClass.Duration) < DateTime.Now;

		<div class="col">
			<div class="card h-100 shadow-sm @(isExpired ? "opacity-75" : "")" style="@(isExpired ? "filter: grayscale(100%);" : "")">
				@if (!string.IsNullOrEmpty(fitnessClass.ImageUrl))
				{
					<img class="card-img-top" src="@fitnessClass.ImageUrl" alt="@fitnessClass.Name" style="height: 200px; object-fit: cover;">
				}
				else
				{
					<img class="card-img-top" src="~/img/no-image-available-02.jpg" alt="Няма налична снимка" style="height: 200px; object-fit: cover;">
				}

				<div class="card-body d-flex flex-column">
					<div class="d-flex justify-content-between align-items-start mb-2">
						<h5 class="card-title text-primary mb-0">@fitnessClass.Name</h5>
						@if (isExpired)
						{
							<span class="badge bg-secondary">ПРИКЛЮЧИЛ</span>
						}
					</div>
					<hr class="mt-1 mb-3" />

					<p class="card-text flex-grow-1 text-center">
						<strong><i class="bi bi-calendar-event"></i> График:</strong><br /> @fitnessClass.Schedule
					</p>

					<div class="alert bg-sidecar border text-center py-2 mb-3" style="font-size: 0.9rem;">
						<strong><i class="bi bi-clock"></i> Време:</strong> @fitnessClass.Duration мин<br />
						<strong><i class="bi bi-people"></i> Места:</strong> @fitnessClass.Capacity
					</div>

					<div class="mt-auto d-flex flex-column gap-2">
						@if (!isExpired)
						{
							<form method="post" asp-controller="FitnessClass" asp-action="AddToMyClasses" asp-route-id="@fitnessClass.Id">
								<button type="submit" class="btn btn-primary w-100">Запиши се</button>
							</form>
							<a asp-controller="FitnessClass" asp-action="Details" asp-route-id="@fitnessClass.Id" class="btn btn-outline-primary w-100">Виж детайли</a>
						}
						else
						{
							<button class="btn btn-secondary w-100" disabled>Затворено</button>
							<a href="javascript:void(0)" class="btn btn-outline-secondary w-100 disabled" style="pointer-events: none;">Детайли (Заключени)</a>
						}
					</div>
				</div>
			</div>
		</div>
	}
</div>

@if (Model.TotalPages > 1)
{
	<nav aria-label="Page navigation" class="mt-5">
		<ul class="pagination justify-content-center">
			@if (Model.HasPreviousPage)
			{
				<li class="page-item">
					<a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-minDuration="@Model.MinDuration" asp-route-maxDuration="@Model.MaxDuration" asp-route-sortOrder="@ViewData["CurrentSort"]">Предишна</a>
				</li>
			}

			@for (int i = 1; i <= Model.TotalPages; i++)
			{
				<li class="page-item @(i == Model.PageNumber ? "active" : "")">
					<a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchQuery="@Model.SearchQuery" asp-route-minDuration="@Model.MinDuration" asp-route-maxDuration="@Model.MaxDuration" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
				</li>
			}

			@if (Model.HasNextPage)
			{
				<li class="page-item">
					<a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-minDuration="@Model.MinDuration" asp-route-maxDuration="@Model.MaxDuration" asp-route-sortOrder="@ViewData["CurrentSort"]">Следваща</a>
				</li>
			}
		</ul>
	</nav>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}