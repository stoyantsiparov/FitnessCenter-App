@model FitnessCenterApp.Web.ViewModels.FitnessClass.FitnessClassDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5 mb-5">
    <h2 class="text-center">@Model.Name</h2>
    <hr class="mb-4" />

    <div class="card shadow border-0 overflow-hidden mx-auto" style="max-width: 1000px;">
        <div class="row g-0">
            <div class="col-md-6 position-relative" style="min-height: 500px;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                }
                else
                {
                    <img src="~/img/no-image-available-02.jpg" alt="No image" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                }
            </div>

            <div class="col-md-6 p-4 d-flex flex-column">
                <h4 class="card-title text-primary mb-3">Информация за класа</h4>

                <div class="flex-grow-1">
                    <p class="card-text text-muted" style="text-align: justify;">
                        <strong>Описание:</strong><br /> @Model.Description
                    </p>

                    <div class="alert bg-sidecar border-0 py-3 mb-4">
                        <p class="mb-2"><strong><i class="bi bi-tag"></i> Цена:</strong> @Model.Price.ToString("C")</p>
                        <p class="mb-2"><strong><i class="bi bi-calendar-event"></i> График:</strong> @Model.Schedule</p>
                        <p class="mb-2"><strong><i class="bi bi-clock"></i> Продължителност:</strong> @Model.Duration минути</p>
                        <p class="mb-0"><strong><i class="bi bi-people"></i> Капацитет:</strong> @Model.Capacity места</p>
                    </div>
                </div>

                <div class="mt-auto">
                    <div class="d-flex gap-2 mb-3">
                        <form method="post" asp-action="AddToMyClasses" asp-route-id="@Model.Id" class="w-50">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Запиши се</button>
                        </form>
                        <a asp-controller="FitnessClass" asp-action="Index" class="btn btn-outline-secondary w-50">Назад към списъка</a>
                    </div>
                    <button class="btn btn-outline-primary w-100" id="showInstructorBtn">Покажи детайли за инструктора</button>
                </div>
            </div>
        </div>
    </div>

    <div id="instructorInfo" class="mt-4 mx-auto" style="display: none; max-width: 1000px;">
        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
            <div class="card-header text-center text-white py-2 bg-primary">
                <span class="fw-bold" style="letter-spacing: 1px;">ИНСТРУКТОР</span>
            </div>
            <div class="card-body p-4 bg-light">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center mb-3 mb-md-0">
                        <img src="@(string.IsNullOrEmpty(Model.Instructor.ImageUrl) ? "/img/no-image-available-02.jpg" : Model.Instructor.ImageUrl)"
                             class="rounded-circle shadow-sm" alt="Инструктор"
                             style="width: 160px; height: 160px; object-fit: cover; border: 5px solid white;" />
                    </div>
                    <div class="col-md-8">
                        <h4 class="text-primary fw-bold mb-1">@Model.Instructor.FirstName @Model.Instructor.LastName</h4>
                        <h6 class="text-muted mb-3"><i class="bi bi-star-fill text-warning me-1"></i> @Model.Instructor.Specialization</h6>
                        <div class="p-3 rounded bg-sidecar border-0">
                            <p class="mb-0 italic" style="color: #4A5568; font-style: italic;">"@Model.Instructor.Bio"</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('showInstructorBtn').addEventListener('click', function () {
            var instructorInfo = document.getElementById('instructorInfo');
            var button = document.getElementById('showInstructorBtn');
            if (instructorInfo.style.display === 'none') {
                instructorInfo.style.display = 'block';
                button.innerText = 'Скрий детайли за инструктора';
                button.classList.replace('btn-outline-primary', 'btn-primary');
                instructorInfo.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                instructorInfo.style.display = 'none';
                button.innerText = 'Покажи детайли за инструктора';
                button.classList.replace('btn-primary', 'btn-outline-primary');
            }
        });
    </script>
}