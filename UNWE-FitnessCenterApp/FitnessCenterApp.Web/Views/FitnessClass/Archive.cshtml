@model IEnumerable<FitnessCenterApp.Web.ViewModels.FitnessClass.AllFitnessClassesViewModel>

@{
	ViewData["Title"] = "Архив на фитнес класове";
}

<h2 class="text-center mt-4">@ViewData["Title"]</h2>
<hr class="mb-4" />

<div class="d-flex justify-content-start mb-3">
	<a asp-action="Index" class="btn btn-secondary">
		<i class="fas fa-arrow-left"></i> Обратно към активните
	</a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
	@foreach (var fitnessClass in Model)
	{
		<div class="col">
			<div class="card h-100 shadow-sm bg-light">
				@if (!string.IsNullOrEmpty(fitnessClass.ImageUrl))
				{
					<img class="card-img-top" src="@fitnessClass.ImageUrl" alt="@fitnessClass.Name" style="height: 200px; object-fit: cover;">
				}
				else
				{
					<img class="card-img-top" src="~/img/no-image-available-02.jpg" alt="Няма налична снимка" style="height: 200px; object-fit: cover;">
				}

				<div class="card-body d-flex flex-column">
					<h5 class="card-title text-primary text-center">@fitnessClass.Name</h5>
					<hr class="mt-1 mb-3" />
					<p class="card-text text-center text-muted"><strong>График:</strong> @fitnessClass.Schedule</p>
					<div class="mt-auto text-center">
						<span class="badge bg-secondary">ПРИКЛЮЧИЛ</span>
					</div>
				</div>
			</div>
		</div>
	}
</div>